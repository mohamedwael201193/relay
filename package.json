{
  "name": "relay",
  "private": true,
  "version": "0.1.0",
  "description": "RELAY — bounded self-driving runners for DreamDEX Event Contracts on Somnia",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.34.5",
  "dependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "@relay/core": "workspace:*",
    "@relay/db": "workspace:*",
    "@somnia-chain/reactivity-contracts": "0.2.1",
    "tsx": "^4.20.5",
    "viem": "^2.37.5"
  },
  "scripts": {
    "doctor": "tsx scripts/doctor.ts",
    "harness": "tsx scripts/harness.ts",
    "faucet": "tsx scripts/faucet.ts",
    "deploy:shannon": "tsx scripts/deploy-shannon.ts",
    "deploy:boost": "tsx scripts/deploy-boost-controller.ts",
    "vault:bootstrap": "tsx scripts/bootstrap-owned-vault.ts",
    "vault:fund": "tsx scripts/vault-funding.ts",
    "place:shannon": "tsx scripts/place-order.ts",
    "settle:shannon": "tsx scripts/settle-shannon.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:persist-gold": "tsx scripts/persist-gold.ts",
    "api": "tsx apps/api/src/server.ts",
    "start": "tsx scripts/render-web.ts",
    "worker": "tsx apps/worker/src/worker.ts",
    "worker:once": "tsx apps/worker/src/worker.ts --once",
    "soak": "tsx scripts/soak.ts",
    "reactivity:probe": "tsx scripts/reactivity-probe.ts",
    "gold:e2e": "tsx scripts/gold-e2e.ts",
    "list:live": "tsx scripts/list-live.ts",
    "render:deploy": "tsx scripts/render-deploy.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:frontend-mocks": "node scripts/check-frontend-mocks.mjs",
    "isolation:owners": "tsx scripts/owner-isolation.ts",
    "owner:lifecycle": "tsx scripts/owner-lifecycle.ts"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
