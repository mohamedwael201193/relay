# RELAY environment template — placeholders only.
# Copy to .env / .env.testnet / .env.mainnet.local and fill locally.
# Never commit real values. Never put secrets in the frontend.

# --- Chain / deployer (backend + contracts only) ---
DEPLOYER_PRIVATE_KEY=
SOMNIA_SHANNON_RPC_URL=https://dream-rpc.somnia.network
SOMNIA_MAINNET_RPC_URL=https://api.infra.mainnet.somnia.network
SOMNIA_SHANNON_WS_URL=wss://api.infra.testnet.somnia.network/ws
SOMNIA_MAINNET_WS_URL=wss://api.infra.mainnet.somnia.network/ws
SOMNIA_SHANNON_CHAIN_ID=50312
SOMNIA_MAINNET_CHAIN_ID=5031
SHANNON_VENUE_ID=
MAINNET_VENUE_ID=
SHANNON_INDEXER_URL=https://dev.smk.somnia.host/v1/graphql
MAINNET_INDEXER_URL=https://prd.smk.somnia.host/v1/graphql

# --- GitHub (CI / ops only; never frontend) ---
GITHUB_TOKEN=
GITHUB_REPO=https://github.com/OWNER/REPO.git

# --- Hosting ---
RENDER_API_KEY=
# Optional: pick a Render workspace by name (default prefers relay-shannon)
RENDER_OWNER_NAME=
# Paid background worker only. Free web uses `pnpm start` (API+worker in one process).
RENDER_CREATE_WORKER=false
VERCEL_TOKEN=

# --- Postgres (Supabase) ---
# Transaction-mode pooler (IPv4) for app queries
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true
# Session-mode / direct for migrations
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Network gate ---
RELAY_NETWORK=shannon
MAINNET_TRADING_ENABLED=false

# --- Optional operator / notifications ---
OPERATOR_PRIVATE_KEY=
REDIS_URL=
TELEGRAM_BOT_TOKEN=
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
